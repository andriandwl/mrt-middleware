{
  "connectors": [
    {
      "id": "scada-main",
      "source": "scada",
      "type": "opcua",
      "parser": "scada-opcua",
      "enabled": true,
      "options": {
        "endpointUrl": "opc.tcp://localhost:4840/UA/MiddlewareSim",
        "securityMode": "None",
        "securityPolicy": "None",
        "userEnv": "SCADA_OPCUA_USER",
        "passwordEnv": "SCADA_OPCUA_PASSWORD",
        "publishingIntervalMs": 1000,
        "samplingIntervalMs": 1000,
        "browseRootNodeId": "ns=0;i=85",
        "readChunkSize": 200
      }
    },
    {
      "id": "nms-trap",
      "source": "nms",
      "type": "snmp-trap",
      "parser": "nms-snmp-trap",
      "enabled": true,
      "options": {
        "host": "0.0.0.0",
        "port": 1162,
        "communityEnv": "NMS_SNMP_COMMUNITY",
        "allowFrom": []
      }
    },
    {
      "id": "nms-syslog",
      "source": "nms",
      "type": "syslog",
      "parser": "nms-syslog",
      "enabled": true,
      "options": {
        "host": "0.0.0.0",
        "port": 5514,
        "allowFrom": []
      }
    },
    {
      "id": "pids-feed",
      "source": "pids",
      "type": "websocket-client",
      "parser": "pids-pidc-feed",
      "enabled": true,
      "options": {
        "url": "ws://localhost:8095/feed",
        "tokenEnv": "PIDS_API_TOKEN",
        "ignoreTypes": [
          "heartbeat"
        ],
        "itemsPath": "items",
        "idField": "messageId",
        "timestampField": "generatedAt",
        "idleTimeoutMs": 60000
      }
    },
    {
      "id": "nms-poll",
      "source": "nms",
      "type": "http-poll",
      "parser": "nms-generic-json",
      "enabled": false,
      "options": {
        "url": "https://nms.example.local/api/alarms",
        "intervalMs": 10000,
        "tokenEnv": "NMS_API_TOKEN",
        "itemsPath": "data",
        "idField": "id",
        "timestampField": "timestamp"
      }
    },
    {
      "id": "pids-webhook",
      "source": "pids",
      "type": "webhook",
      "parser": "pids-generic-json",
      "enabled": false,
      "options": {
        "host": "0.0.0.0",
        "port": 8091,
        "path": "/ingest/pids",
        "secretEnv": "WEBHOOK_SHARED_SECRET",
        "idField": "id",
        "timestampField": "timestamp"
      }
    }
  ]
}
