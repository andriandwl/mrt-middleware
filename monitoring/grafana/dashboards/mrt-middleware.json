      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (connector) (rate(mrt_mw_records_received_total[5m]))",
          "legendFormat": "{{connector}}"
        }
